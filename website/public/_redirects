# Netlify redirects (WEB-04). First match wins; the SPA fallback must stay last.
#
# The old pkgdown site's /reference/<fn>.html and /articles/<name>.html URLs are
# identical in the new site (React Router strips ".html"), so they need no rule.
# Only pages the new site does not have are mapped here.

/reference/tidyfault.html          /reference/   301
/reference/tidyfault-package.html  /reference/   301
/articles/index.html               /articles/    301
/authors.html                      https://github.com/timothyfraser/tidyfault/blob/main/DESCRIPTION  301
/news/index.html                   https://github.com/timothyfraser/tidyfault/blob/main/NEWS.md      301
/news/                             https://github.com/timothyfraser/tidyfault/blob/main/NEWS.md      301
/LICENSE-text.html                 https://github.com/timothyfraser/tidyfault/blob/main/LICENSE      301
/EXTERNAL_FUNCTIONS.html           https://github.com/timothyfraser/tidyfault/blob/main/EXTERNAL_FUNCTIONS.md  301
/404.html                          /index.html   404

# The deck is a static file tree; Netlify serves existing files before redirects,
# so /slides/ needs no rule. Everything else goes to the single-page app.
/*                                 /index.html   200
