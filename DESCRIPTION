Package: tidyfault
Title: Tidy Fault Tree Analysis
Version: 0.1.0
Authors@R: c(
    person("Timothy", "Fraser", , "tmf77@cornell.edu", role = c("aut", "cre", "cph"),
           comment = c(ORCID = "0000-0002-4509-0244")),
    person("Jingyao", "Tong", , "jingyaotong6@gmail.com", role = c("aut", "cph"),
           comment = c(ORCID = "0009-0009-6147-756X")),
